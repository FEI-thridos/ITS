<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram id="usecase" name="Use-case diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="KUKA FM Middleware" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="220" y="30" width="880" height="760" as="geometry"/></mxCell><mxCell id="subM" value="&amp;laquo;subsystem&amp;raquo; &lt;b&gt;Mission Management&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="820" height="380" as="geometry"/></mxCell><mxCell id="subR" value="&amp;laquo;subsystem&amp;raquo; &lt;b&gt;Robot Management&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="250" y="480" width="820" height="280" as="geometry"/></mxCell><mxCell id="op" value="Operator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="110" y="250" width="30" height="60" as="geometry"/></mxCell><mxCell id="sch" value="&amp;laquo;timer&amp;raquo;&lt;br&gt;Scheduler" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="110" y="560" width="30" height="60" as="geometry"/></mxCell><mxCell id="kuka" value="&amp;laquo;system&amp;raquo;&lt;br&gt;KUKA FM" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1200" y="380" width="30" height="60" as="geometry"/></mxCell><mxCell id="uc1" value="UC1&lt;br&gt;Dispatch mission" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="200" height="60" as="geometry"/></mxCell><mxCell id="uc2" value="UC2&lt;br&gt;Cancel mission" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="190" width="200" height="60" as="geometry"/></mxCell><mxCell id="uc3" value="UC3&lt;br&gt;View mission status&lt;br&gt;(active &amp;amp; finished)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="270" width="200" height="60" as="geometry"/></mxCell><mxCell id="uc4" value="UC4&lt;br&gt;View mission status history" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="580" y="270" width="200" height="60" as="geometry"/></mxCell><mxCell id="uc5" value="UC5&lt;br&gt;Synchronize mission status" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="200" height="60" as="geometry"/></mxCell><mxCell id="i1" value="Call KUKA &lt;i&gt;submitMission&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="200" height="60" as="geometry"/></mxCell><mxCell id="i2" value="Call KUKA &lt;i&gt;missionCancel&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="840" y="190" width="200" height="60" as="geometry"/></mxCell><mxCell id="i3" value="Call KUKA &lt;i&gt;jobQuery&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="840" y="370" width="200" height="60" as="geometry"/></mxCell><mxCell id="uc6" value="UC6&lt;br&gt;View robot status" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="200" height="60" as="geometry"/></mxCell><mxCell id="uc7" value="UC7&lt;br&gt;View robot status history" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="580" y="520" width="200" height="60" as="geometry"/></mxCell><mxCell id="uc8" value="UC8&lt;br&gt;Synchronize robot status" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="650" width="200" height="60" as="geometry"/></mxCell><mxCell id="i4" value="Call KUKA &lt;i&gt;robotQuery&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="840" y="650" width="200" height="60" as="geometry"/></mxCell><mxCell id="aop0" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="op" target="uc1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="aop1" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="op" target="uc2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="aop2" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="op" target="uc3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="aop3" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="op" target="uc6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="asch0" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="sch" target="uc5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="asch1" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="sch" target="uc8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="akuka0" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="i1" target="kuka"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="akuka1" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="i2" target="kuka"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="akuka2" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="i3" target="kuka"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="akuka3" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="i4" target="kuka"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc0" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;endSize=10;fontSize=11;" edge="1" parent="1" source="uc1" target="i1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc1" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;endSize=10;fontSize=11;" edge="1" parent="1" source="uc2" target="i2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc2" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;endSize=10;fontSize=11;" edge="1" parent="1" source="uc5" target="i3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc3" value="&amp;laquo;include&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;endSize=10;fontSize=11;" edge="1" parent="1" source="uc8" target="i4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ext1" value="&amp;laquo;extend&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;endSize=10;fontSize=11;" edge="1" parent="1" source="uc4" target="uc3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ext2" value="&amp;laquo;extend&amp;raquo;" style="endArrow=open;dashed=1;html=1;rounded=0;endSize=10;fontSize=11;" edge="1" parent="1" source="uc7" target="uc6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue = base use case&lt;br&gt;Purple = extending use case&lt;br&gt;Yellow = included use case (KUKA FM API call)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="220" y="810" width="360" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="descriptions" name="Use-case descriptions"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="desc" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:12px;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:6px;background:#dae8fc;text-align:left;&quot;&gt;ID&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:6px;background:#dae8fc;text-align:left;&quot;&gt;Use case&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:6px;background:#dae8fc;text-align:left;&quot;&gt;Actor&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:6px;background:#dae8fc;text-align:left;&quot;&gt;Goal&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:6px;background:#dae8fc;text-align:left;&quot;&gt;Main scenario&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;UC1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Dispatch mission&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Operator&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Send a new RACK_MOVE mission to KUKA FM.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;1. Operator opens Mission management and fills start node, target node, container code, priority and optional robot ID.&lt;br&gt;2. System validates the input.&lt;br&gt;3. System calls KUKA &lt;i&gt;submitMission&lt;/i&gt; (other params from appsettings).&lt;br&gt;4. System stores the mission with status Created and logs the operation.&lt;br&gt;5. System shows confirmation.&lt;br&gt;&lt;i&gt;Alt:&lt;/i&gt; KUKA FM returns an error &amp;rarr; error is shown and logged, mission is not tracked.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;UC2&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Cancel mission&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Operator&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Stop an active mission.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;1. Operator selects an active mission and confirms Cancel.&lt;br&gt;2. System calls KUKA &lt;i&gt;missionCancel&lt;/i&gt; with cancelMode FORCE.&lt;br&gt;3. System logs the operation and shows confirmation.&lt;br&gt;4. Final status (Cancelled) is picked up by UC5.&lt;br&gt;&lt;i&gt;Alt:&lt;/i&gt; KUKA FM returns an error &amp;rarr; error is shown and logged.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;UC3&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;View mission status&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Operator&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;See current status of active and finished missions.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;1. Operator opens Missions list.&lt;br&gt;2. System shows missions with their current status (filter: active / finished).&lt;br&gt;3. List refreshes every 1 s.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;UC4&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;View mission status history&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Operator&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;See all previous statuses of one mission (extends UC3).&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;1. In UC3 Operator selects a mission.&lt;br&gt;2. System shows all previous statuses with timestamps.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;UC5&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Synchronize mission status&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Scheduler&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Keep stored mission statuses up to date.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;1. Scheduler triggers at configured interval.&lt;br&gt;2. System loads tracked missions with active status (10, 20, 25, 28, 50).&lt;br&gt;3. System calls KUKA &lt;i&gt;jobQuery&lt;/i&gt;.&lt;br&gt;4. If status changed: previous state is copied to history, current state is updated.&lt;br&gt;5. Missions with final status (30, 31, 35, 60) are no longer polled.&lt;br&gt;6. Errors are logged.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;UC6&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;View robot status&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Operator&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;See current status of all robots.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;1. Operator opens Robots list.&lt;br&gt;2. System shows robots with status Available / Busy / Offline, battery, node and mission.&lt;br&gt;3. List refreshes every 1 s.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;UC7&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;View robot status history&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Operator&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;See all previous statuses of one robot (extends UC6).&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;1. In UC6 Operator selects a robot.&lt;br&gt;2. System shows all previous statuses with timestamps.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;UC8&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Synchronize robot status&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Scheduler&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;Keep stored robot statuses up to date.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:6px;vertical-align:top;text-align:left;&quot;&gt;1. Scheduler triggers at configured interval.&lt;br&gt;2. System calls KUKA &lt;i&gt;robotQuery&lt;/i&gt; (all robots).&lt;br&gt;3. System maps KUKA status: Idle &amp;rarr; Available; Departure, Executing, Charging, Updating &amp;rarr; Busy; Offline, Abnormal &amp;rarr; Offline.&lt;br&gt;4. New robots are inserted; if a robot's state changed, previous state is copied to history and current state is updated.&lt;br&gt;5. Errors are logged.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1200" height="1000" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
