# Production environment for docker compose (--env-file docker/.env.prod).
# Placeholders only - replaced by ci-cd/cd.yml with secret pipeline variables before any docker command.
# Values are single-quoted so compose takes them literally (no $ interpolation).
ASPNETCORE_ENVIRONMENT=Production
POSTGRES_USER='__DB_USER__'
POSTGRES_PASSWORD='__DB_PASSWORD__'
POSTGRES_DB='__DB_NAME__'
